function fun_analysis_mass(phi,range_phi, step_phi, th, range_th, step_th, L, range_L, step_L, n_st, n_st_range ,n_e, n_e_range)

% Design variables
% phi = [3.7, 3.7, 3.7];    % Rocket stage diameter (3rd, 2nd, 1st) [m]
% th = [0.005, 0.005, 0.005]; % Rocket stage wall thickness (3rd, 2nd, 1st) [m]
% L = [10, 10, 20];     % Rocket stage length (3rd, 2nd, 1st) [m]
% n_st = 3;   % Number of stages
% n_e = 6;   % Number of engines (in the 1st stage)

% Define constant parameters
parameters;

% Objective function
% f = structural_mass(phi, th, L, n_st, n_e);

% Define ranges and steps for Objective Function analysis
phi_range = 0.001:step_phi:range_phi; % Range and step for diameter
th_range = 0.000001 :step_th:range_th; % Range and step for thickness
L_range = 0.01 :step_L:range_L; % Range and step for length

% Objective Function analysis for phi
f_phi = zeros(size(phi_range));
for i = 1:length(phi_range)
    phi_temp = phi;
    phi_temp(1) = phi_range(i); % Change first stage diameter as an example
    f_phi(i) = structural_mass(phi_temp, th, L, n_st, n_e);
end

%% Continuous variable
figure;
subplot(3,1,1);
plot(phi_range, f_phi, '-');
xlabel('1st Stage Diameter [m]');
ylabel('Structural Mass [kg]');
title('Objective Function Analysis: Diameter 1st stage');
legend([', S1 thickness [m] = ', num2str(th(3)), ', S1 length [m] = ', num2str(L(3)),  ', Number of stages = ', num2str(n_st), ', Number of S1 engines = ', num2str(n_e)], 'Location', 'best');
grid on;

% Objective Function analysis for th
f_th = zeros(size(th_range));
for i = 1:length(th_range)
    th_temp = th;
    th_temp(1) = th_range(i); % Change first stage wall thickness as an example
    f_th(i) = structural_mass(phi, th_temp, L, n_st, n_e);
end

subplot(3,1,2);
plot(th_range, f_th, '-');
xlabel('1st Stage Wall Thickness [m]');
ylabel('Structural Mass [kg]');
title('Objective Function Analysis: Wall Thickness 1 stage');
legend(['S1 diameter [m] = ', num2str(phi(3)), ', S1 length [m] = ', num2str(L(3)),  ', Number of stages = ', num2str(n_st), ', Number of S1 engines = ', num2str(n_e)], 'Location', 'best');
grid on;

% Objective Function analysis for L
f_L = zeros(size(L_range));
for i = 1:length(L_range)
    L_temp = L;
    L_temp(1) = L_range(i); % Change first stage length
    f_L(i) = structural_mass(phi, th, L_temp, n_st, n_e);
end

subplot(3,1,3);
plot(L_range, f_L, '-');
xlabel('1st Stage Length [m]');
ylabel('Structural Mass [kg]');
title('Objective Function Analysis: Length 1 stage');
legend(['S1 diameter [m] = ', num2str(phi(3)), ', S1 thickness [m] = ', num2str(th(3)), ', Number of stages = ', num2str(n_st), ', Number of S1 engines = ', num2str(n_e)], 'Location', 'best');
grid on;

%% Discrete variables
% Objective Function analysis for n_st
n_st_values = 2:1:3; % cant go more than 3 due to how other functions are defined. Also no less than 2 because how the code is defined
f_n_st = zeros(size(n_st_values));
total_L = sum(L)
% L_loop = [total_L, total_L/2, total_L/3];
L_loop = [total_L/2, total_L/3];
% L_loop = [30, 15, 10];
f_L = zeros(size(L_loop));
for i = 1:length(L_loop)
    L_temp = L;
    L_temp(1) = L_loop(i); % Change first stage length
    f_n_st(i) = structural_mass(phi, th, L_temp, n_st_values(i), n_e);
end

figure;
subplot(2,1,1);
plot(n_st_values, f_n_st, '-o');
xlabel('Number of Stages');
ylabel('Structural Mass [kg]');
title('Objective Function Analysis: Number of Stages');
legend(['S1 diameter [m] = ', num2str(phi(3)), ', S1 thickness [m] = ', num2str(th(3)), ', TOTAL length [m] = ', num2str(total_L), ', Number of S1 engines = ', num2str(n_e)], 'Location', 'best');
grid on;

% Annotate points with L values
for i = 1:length(n_st_values)
    text(n_st_values(i), f_n_st(i), ['L[m] = ', num2str(L_loop(i))], 'VerticalAlignment', 'bottom', 'HorizontalAlignment', 'right');
end

% Set x-ticks to only show 2 and 3
xticks([2 3]);
xticklabels({'2', '3'});


% Objective Function analysis for n_e
n_e_values = 1:1:n_e_range;
f_n_e = zeros(size(n_e_values));
for i = 1:length(n_e_values)
    f_n_e(i) = structural_mass(phi, th, L, n_st, n_e_values(i));
end

subplot(2,1,2);
plot(n_e_values, f_n_e, '-o');
xlabel('Number of Engines');
ylabel('Structural Mass [kg]');
title('Objective Function Analysis: Number of Engines');
legend(['S1 diameter [m] = ', num2str(phi(3)), ', S1 thickness [m] = ', num2str(th(3)), ', S1 length [m] = ', num2str(L(3)), ', Number of stages = ', num2str(n_st)], 'Location', 'best');
grid on;
